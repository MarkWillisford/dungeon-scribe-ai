rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin check — reads from Custom Claim, not Firestore.
    // Claim is set server-side only via scripts/setAdminClaim.ts.
    function isAdmin() {
      return isAuthenticated() && request.auth.token.get('admin', false) == true;
    }

    function getCampaign(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)).data;
    }

    function isDM(campaignId) {
      return isAuthenticated() && getCampaign(campaignId).dmId == request.auth.uid;
    }

    function isCampaignMember(campaignId) {
      return isAuthenticated() &&
        request.auth.uid in getCampaign(campaignId).memberIds;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId);
      allow update: if isUser(userId);
    }

    // Play sessions — per-character live session state
    match /users/{userId}/sessions/{sessionId} {
      allow read, write: if isUser(userId);
    }

    // Characters collection — ownership-based access
    match /characters/{characterId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // User preferences
    match /userPreferences/{userId} {
      allow read: if isUser(userId);
      allow write: if isUser(userId);
    }

    // Game data collections — official & campaign content
    // Read: any authenticated user (Phase B reads these at runtime).
    // Write: admin only — enforces that only scripts/setAdminClaim.ts holders
    //   or the future admin panel can modify game data from a client.
    //   The Admin SDK (seed scripts) bypasses these rules entirely.
    //
    // NOTE: Collection names are case-sensitive and MUST match the names the
    //   seed scripts write to (scripts/db/*) and the connector reads
    //   (FirestoreGameDataConnector). The class-choice option collections are
    //   seeded lowercase (e.g. 'roguetalents', 'cavalierorders'); a camelCase
    //   match path here is a silent default-deny. See issue #244.
    //
    // Collections: races, classes, feats, traits, spells, templates, deities,
    //   domains, animalCompanions, bloodlines, cavalierorders, inquisitions,
    //   mysteries, revelations, ragepowers, roguetalents, hexes, arcanistexploits,
    //   investigatortalents, wildtalents, magusarcana, mesmeristtricks,
    //   ninjatricks, occultistfocuspowers, phrenicamplifications, shamanspirits,
    //   slayertalents, warpriestblessings, alchemistdiscoveries, eidolonevolutions,
    //   classChoiceDefinitions, racialChoiceDefinitions, rulesets, magicItems,
    //   weapons, armor, shields, gear,
    //   disciplines, maneuvers, stances, martialTraditions, favoredClassBonuses,
    //   eidolonbaseforms, eidolonsubtypes
    match /races/{docId}                    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /classes/{docId}                  { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /feats/{docId}                    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /traits/{docId}                   { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /spells/{docId}                   { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /templates/{docId}               { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /deities/{docId}                  { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /domains/{docId}                  { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /animalCompanions/{docId}         { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /bloodlines/{docId}              { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /cavalierorders/{docId}           { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /inquisitions/{docId}             { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /mysteries/{docId}               { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /revelations/{docId}             { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /ragepowers/{docId}              { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /roguetalents/{docId}            { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /hexes/{docId}                   { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /arcanistexploits/{docId}        { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /investigatortalents/{docId}     { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /wildtalents/{docId}             { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /magusarcana/{docId}             { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /mesmeristtricks/{docId}         { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /ninjatricks/{docId}             { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /occultistfocuspowers/{docId}    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /phrenicamplifications/{docId}   { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /shamanspirits/{docId}           { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /slayertalents/{docId}           { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /warpriestblessings/{docId}      { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /alchemistdiscoveries/{docId}    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /eidolonevolutions/{docId}       { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /archetypes/{docId}              { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /classChoiceDefinitions/{docId}  { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /racialChoiceDefinitions/{docId} { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /rulesets/{docId}                { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /magicItems/{docId}              { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /weapons/{docId}                 { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /armor/{docId}                   { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /shields/{docId}                 { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /gear/{docId}                    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /disciplines/{docId}             { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /maneuvers/{docId}               { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /stances/{docId}                 { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /martialTraditions/{docId}       { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /favoredClassBonuses/{docId}    { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /eidolonbaseforms/{docId}       { allow read: if isAuthenticated(); allow write: if isAdmin(); }
    match /eidolonsubtypes/{docId}        { allow read: if isAuthenticated(); allow write: if isAdmin(); }

    // Campaigns collection
    match /campaigns/{campaignId} {
      allow read: if isCampaignMember(campaignId);
      allow create: if isAuthenticated();
      allow update: if isDM(campaignId);
      allow delete: if isDM(campaignId);

      // Notes subcollection
      match /notes/{noteId} {
        allow read: if isCampaignMember(campaignId) && (
          resource.data.type == 'shared' ||
          (resource.data.type == 'personal' && resource.data.authorId == request.auth.uid) ||
          (resource.data.type == 'dm' && isDM(campaignId))
        );
        allow create: if isCampaignMember(campaignId);
        allow update: if isCampaignMember(campaignId) && (
          resource.data.authorId == request.auth.uid ||
          isDM(campaignId)
        );
        allow delete: if resource.data.authorId == request.auth.uid || isDM(campaignId);
      }

      // Sessions subcollection
      match /sessions/{sessionId} {
        allow read: if isCampaignMember(campaignId);
        allow write: if isDM(campaignId);
      }

      // Handouts subcollection
      match /handouts/{handoutId} {
        allow read: if isCampaignMember(campaignId) && (
          resource.data.isRevealed ||
          request.auth.uid in resource.data.revealedTo ||
          isDM(campaignId)
        );
        allow write: if isDM(campaignId);
      }
    }
  }
}
