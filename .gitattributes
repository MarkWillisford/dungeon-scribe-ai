# Normalize all text files to LF in the repo to prevent CRLF/LF drift across
# Windows, WSL, macOS, and Linux checkouts. Binary files are left untouched.
* text=auto eol=lf

# Explicitly binary (don't try to normalize)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.zip binary
